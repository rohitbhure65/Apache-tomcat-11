<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
                             https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <display-name>ROOT Web Application</display-name>
    <description>Demonstration of web.xml with Servlet Filtering in Tomcat 11</description>

    <!-- ============================================================== -->
    <!-- 1. Filter Definition                                           -->
    <!-- ============================================================== -->
    <filter>
        <filter-name>LoggingFilter</filter-name>
        <filter-class>LoggingFilter</filter-class>

        <!-- Optional Initialization Parameters accessible in init() -->
        <init-param>
            <param-name>logLevel</param-name>
            <param-value>INFO</param-value>
        </init-param>
    </filter>

    <!-- ============================================================== -->
    <!-- 2. Filter Mapping                                              -->
    <!-- ============================================================== -->
    <!-- url-pattern "/*" applies this filter to every incoming request.  -->
    <!-- You can also map to specific paths like "/hello" or "*.do".   -->
    <filter-mapping>
        <filter-name>LoggingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- ============================================================== -->
    <!-- 3. Servlet Definition and Mapping                              -->
    <!-- ============================================================== -->
    <servlet>
        <servlet-name>HelloServlet</servlet-name>
        <servlet-class>HelloServlet</servlet-class>
        <init-param>
            <param-name>author</param-name>
            <param-value>Rohit</param-value>
        </init-param>
        <load-on-startup>1</load-on-startup>
    </servlet>

    <servlet-mapping>
        <servlet-name>HelloServlet</servlet-name>
        <url-pattern>/hello</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>example</servlet-name>
        <servlet-class>example</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>example</servlet-name>
        <url-pattern>/example</url-pattern>
    </servlet-mapping>

    <!-- ============================================================== -->
    <!-- 4. Default Welcome Files                                       -->
    <!-- ============================================================== -->
    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- ============================================================== -->
    <!-- 5. Context-param                                               -->
    <!-- ============================================================== -->
    <Context-param>
        <param-name>college</param-name>
        <param-value>abc college<param-value>
    </Context-param>

</web-app>

